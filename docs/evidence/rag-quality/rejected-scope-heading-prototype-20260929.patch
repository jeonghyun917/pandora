+	private String withSourceHeading(CandidateAtom candidate, List<LawAiAnswerGround> grounds) {
+		String atom = clean(candidate.text());
+		LawAiAnswerGround ground = grounds.get(candidate.groundIndex());
+		String heading = clean(String.valueOf(ground.chunkTitle() == null ? "" : ground.chunkTitle())
+			.replaceFirst("(?i)^p\\.\\d+\\s*", ""));
+		String source = normalize(matchedChildText(ground));
+		if (!"direct".equalsIgnoreCase(ground.evidenceRole()) || heading.isBlank()
+			|| heading.length() > 80 || ARTICLE_HEADING_ONLY.matcher(heading).matches()
+			|| !source.startsWith(normalize(heading)) || !source.contains(normalize(atom))
+			|| normalize(atom).contains(normalize(heading))) {
+			return atom;
+		}
+		// Keep only a heading present in this exact child; the combined claim is
+		// subsequently subjected to the same support and alignment checks as any atom.
+		return heading + ": " + atom;
+	}
+
 	private String stripLeadingArticleHeadings(String atom) {
 		return clean(LEADING_ARTICLE_HEADINGS.matcher(clean(atom)).replaceFirst(""));
 	}
